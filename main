    <div class="container">

        <!-- HOME -->
        <section id="home" class="welcome">
            <h2>Welcome to My E-Portfolio!</h2>
            <p>
                This portfolio is a place where I can collect and display
                my Grade 9 projects, assignments, achievements, and reflections.
                It shows my progress and what I have learned throughout the school year.
            </p>
        </section>

        <!-- PROFILE -->
        <section id="profile" class="card">
            <h2>👩‍🎓 My Profile</h2>

            <div class="profile">
                <div>
                    <label>Student Name:</label>
                    <input type="text" id="studentName"
                           placeholder="Enter your name">

                    <label>Grade:</label>
                    <input type="text" value="Grade 9" readonly>

                    <label>School:</label>
                    <input type="text" id="school"
                           placeholder="Enter your school">
                </div>

                <div>
                    <label>About Me:</label>
                    <textarea id="about"
                              placeholder="Write something about yourself..."></textarea>

                    <button onclick="saveProfile()">Save Profile</button>
                </div>
            </div>
        </section>

        <!-- PROJECTS -->
        <section id="projects" class="card">
            <h2>📁 My Projects</h2>

            <label>Project Title:</label>
            <input type="text" id="projectTitle"
                   placeholder="Example: Science Volcano Project">

            <label>Subject:</label>
            <select id="projectSubject">
                <option>Science</option>
                <option>Mathematics</option>
                <option>English</option>
                <option>Social Studies</option>
                <option>Computer Studies</option>
                <option>Art</option>
                <option>Other</option>
            </select>

            <label>Description:</label>
            <textarea id="projectDescription"
                      placeholder="Describe your project..."></textarea>

            <button onclick="addProject()">➕ Add Project</button>

            <br><br>

            <div class="projects" id="projectList">
                <!-- Projects will appear here -->
            </div>
        </section>

        <!-- REFLECTION -->
        <section id="reflection" class="card">
            <h2>💭 My Reflection</h2>

            <label>What did I learn?</label>
            <textarea id="learning"
                      placeholder="Write about what you learned..."></textarea>

            <label>What was challenging?</label>
            <textarea id="challenge"
                      placeholder="Describe something that was difficult..."></textarea>

            <label>What would I improve?</label>
            <textarea id="improve"
                      placeholder="Write about what you would do differently..."></textarea>

