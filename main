    <script>

        // Load saved projects when the page opens
        window.onload = function() {
            loadProjects();
            loadProfile();
            loadReflection();
        };


        // SAVE PROFILE
        function saveProfile() {
            const profile = {
                name: document.getElementById("studentName").value,
                school: document.getElementById("school").value,
                about: document.getElementById("about").value
            };

            localStorage.setItem("profile", JSON.stringify(profile));

            alert("Profile saved successfully!");
        }


        // LOAD PROFILE
        function loadProfile() {
            const savedProfile = localStorage.getItem("profile");

            if (savedProfile) {
                const profile = JSON.parse(savedProfile);

                document.getElementById("studentName").value = profile.name;
                document.getElementById("school").value = profile.school;
                document.getElementById("about").value = profile.about;
            }
        }


        // ADD PROJECT
        function addProject() {

            const title = document.getElementById("projectTitle").value;
            const subject = document.getElementById("projectSubject").value;
            const description = document.getElementById("projectDescription").value;

            if (title === "" || description === "") {
                alert("Please enter a project title and description.");
                return;
            }

            const project = {
                title: title,
                subject: subject,
                description: description
            };

            let projects = JSON.parse(localStorage.getItem("projects")) || [];

            projects.push(project);

            localStorage.setItem("projects", JSON.stringify(projects));

            document.getElementById("projectTitle").value = "";
            document.getElementById("projectDescription").value = "";

            loadProjects();
        }


        // DISPLAY PROJECTS
        function loadProjects() {

            const projectList = document.getElementById("projectList");

            projectList.innerHTML = "";

            let projects = JSON.parse(localStorage.getItem("projects")) || [];

            if (projects.length === 0) {
                projectList.innerHTML =
                    "<p>No projects added yet. Add your first project above!</p>";
                return;
            }

            projects.forEach(function(project, index) {

                const projectDiv = document.createElement("div");

                projectDiv.className = "project";

                projectDiv.innerHTML = `
                    <h3>${project.title}</h3>
                    <p><strong>Subject:</strong> ${project.subject}</p>
                    <p>${project.description}</p>

                    <button class="delete-btn"
                        onclick="deleteProject(${index})">
                        Delete
                    </button>
                `;

                projectList.appendChild(projectDiv);
            });
        }


        // DELETE PROJECT
        function deleteProject(index) {

            let projects = JSON.parse(localStorage.getItem("projects")) || [];

            projects.splice(index, 1);

            localStorage.setItem("projects", JSON.stringify(projects));

            loadProjects();
        }


        // SAVE REFLECTION
        function saveReflection() {

            const reflection = {
                learning: document.getElementById("learning").value,
                challenge: document.getElementById("challenge").value,
                improve: document.getElementById("improve").value
            };

            localStorage.setItem(
                "reflection",
                JSON.stringify(reflection)
            );

            alert("Reflection saved successfully!");
        }


        // LOAD REFLECTION
        function loadReflection() {

            const savedReflection =
                localStorage.getItem("reflection");

            if (savedReflection) {

                const reflection =
                    JSON.parse(savedReflection);

                document.getElementById("learning").value =
                    reflection.learning;

                document.getElementById("challenge").value =
                    reflection.challenge;

                document.getElementById("improve").value =
                    reflection.improve;
            }
        }

    </script>

